#!/bin/bash

source "$(dirname "$0")"/build-info.sh

keymap=${2:-hunner}

flash_keyboard() {
  hex="$(echo "${1}"|tr '/' '_')_${keymap}.hex"

  if [ ! -e "${hex}" ]; then
    echo "No file found: ${hex}"
    exit 1
  fi

  echo -n "Waiting for device."
  while [ ! -e "/dev/ttyACM0" ]; do
    sleep 1
    echo -n "."
  done
  avrdude -p atmega32u4 -c avr109 -P /dev/ttyACM0 -U flash:w:"${hex}"
}

flash_keyboard $@
